@startuml CafeteriaSystem
' =====================================================================
' Sistema de gestion de pedidos de cafeteria "La Terminal".
' Diagrama sincronizado con el codigo (paquete raiz: cafeteria.*).
' Patrones: Template Method, Decorator, Composite, Factory Method,
' Abstract Factory, State, Observer, Strategy, Adapter, Singleton, Facade.
' =====================================================================

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members

' =====================================================================
' SUBSISTEMA 1 - PRODUCTS
' Patrones: Template Method, Decorator, Composite
' =====================================================================
package "products" {

    interface Product {
        + getPrice(): Double
        + getDescription(): String
        + prepare(): void
    }

    abstract class ProductBase {
        + {final} prepare(): void
        # reserveStation(): void
        # {abstract} prepareIngredients(): void
        # {abstract} cook(): void
        # plate(): void
        # notifyReady(): void
    }
    note right of ProductBase
        Template Method:
        prepare() es final y fija el orden.
        Las subclases solo rellenan
        prepareIngredients() y cook().
    end note

    Product <|.. ProductBase

    package "products.beverage.coffe" {
        abstract class Coffee
        class Espresso
        class Cappuccino
        class Latte
        class Americano

        ProductBase <|-- Coffee
        Coffee <|-- Espresso
        Coffee <|-- Cappuccino
        Coffee <|-- Latte
        Coffee <|-- Americano
    }

    package "products.beverage.tea" {
        abstract class Tea
        class RedTea
        class BlackTea
        class GreenTea
        class Matcha

        ProductBase <|-- Tea
        Tea <|-- RedTea
        Tea <|-- BlackTea
        Tea <|-- GreenTea
        Tea <|-- Matcha
    }

    package "products.beverage.softDrink" {
        abstract class SoftDrinks
        class Water
        class Juice

        ProductBase <|-- SoftDrinks
        SoftDrinks <|-- Water
        SoftDrinks <|-- Juice
    }

    package "products.food.pastry" {
        abstract class Pastry
        class Suizo
        class Palmera
        class Croissant
        class Donut

        ProductBase <|-- Pastry
        Pastry <|-- Suizo
        Pastry <|-- Palmera
        Pastry <|-- Croissant
        Pastry <|-- Donut
    }

    package "products.food.bread" {
        abstract class Bread
        class PanPayes
        class Baguette
        class Chapata

        ProductBase <|-- Bread
        Bread <|-- PanPayes
        Bread <|-- Baguette
        Bread <|-- Chapata
    }

    package "products.food.launch" {
        interface ItemLaunch {
            + getPrice(): Double
            + getDescription(): String
        }

        abstract class LaunchProduct

        class CombinedDish {
            - components: List<ItemLaunch>
            + add(item: ItemLaunch): void
            + getPrice(): Double
            + getDescription(): String
            + prepare(): void
        }
        note right of CombinedDish
            Composite:
            agrupa varios ItemLaunch
            (hojas u otros compuestos)
            y los trata como uno solo.
        end note

        ProductBase <|-- LaunchProduct
        ItemLaunch <|.. LaunchProduct
        Product <|.. CombinedDish
        ItemLaunch <|.. CombinedDish
        CombinedDish o--> "0..*" ItemLaunch : components

        class Eggs
        class Bacon
        class Sausages
        class Yogurt
        class Fruit

        LaunchProduct <|-- Eggs
        LaunchProduct <|-- Bacon
        LaunchProduct <|-- Sausages
        LaunchProduct <|-- Yogurt
        LaunchProduct <|-- Fruit
    }

    package "products.decorator" {
        abstract class ProductDecorator {
            # wrapped: Product
            + getPrice(): Double
            + getDescription(): String
            + prepare(): void
            # {abstract} extraPrice(): Double
            # {abstract} extraDescription(): String
        }
        note right of ProductDecorator
            Decorator:
            envuelve un Product y delega,
            sumando precio y modificando
            la descripcion via extraPrice()
            y extraDescription().
        end note

        Product <|.. ProductDecorator
        ProductDecorator o--> "1" Product : wrapped

        package "products.decorator.toppings" {
            abstract class Topping
            class Sugar
            class Honey
            class LactoseFreeMilk
            class OatMilk

            ProductDecorator <|-- Topping
            Topping <|-- Sugar
            Topping <|-- Honey
            Topping <|-- LactoseFreeMilk
            Topping <|-- OatMilk
        }

        package "products.decorator.formats" {
            abstract class Format
            class Toasted
            class HalfToasted
            class Unit

            ProductDecorator <|-- Format
            Format <|-- Toasted
            Format <|-- HalfToasted
            Format <|-- Unit
        }
    }
}

' =====================================================================
' SUBSISTEMA 2 - FACTORIES
' Patrones: Factory Method, Abstract Factory
' =====================================================================
package "factories" {

    package "factories.products" {
        interface ProductFactory {
            + create(type: String): Product
        }
        note right of ProductFactory
            Factory Method:
            cada subfamilia tiene su
            fabrica concreta que sabe
            instanciar sus productos.
        end note

        class CoffeeFactory
        class TeaFactory
        class SoftDrinkFactory
        class BreadFactory
        class PastryFactory
        class LaunchFactory

        ProductFactory <|.. CoffeeFactory
        ProductFactory <|.. TeaFactory
        ProductFactory <|.. SoftDrinkFactory
        ProductFactory <|.. BreadFactory
        ProductFactory <|.. PastryFactory
        ProductFactory <|.. LaunchFactory
    }

    package "factories.toppings" {
        interface ToppingFactory {
            + createSugar(p: Product): Topping
            + createHoney(p: Product): Topping
            + createLactoseFreeMilk(p: Product): Topping
            + createOatMilk(p: Product): Topping
        }
        note right of ToppingFactory
            Abstract Factory:
            cada bebida expone la familia
            de toppings validos para ella.
            Los no validos lanzan
            UnsupportedOperationException.
        end note

        class EspressoToppingFactory
        class CappuccinoToppingFactory
        class LatteToppingFactory
        class TeaToppingFactory

        ToppingFactory <|.. EspressoToppingFactory
        ToppingFactory <|.. CappuccinoToppingFactory
        ToppingFactory <|.. LatteToppingFactory
        ToppingFactory <|.. TeaToppingFactory
    }
}

' =====================================================================
' SUBSISTEMA 3 - ORDERS
' Patrones: State, Observer
' =====================================================================
package "orders" {

    class Order {
        - id: Integer
        - items: List<Product>
        - state: OrderState
        - observers: List<OrderObserver>
        + addItem(p: Product): void
        + pay(method: PaymentMethod): void
        + prepare(): void
        + markReady(): void
        + deliver(): void
        + setState(s: OrderState): void
        + registerObserver(o: OrderObserver): void
        + removeObserver(o: OrderObserver): void
        + getTotal(): Double
    }

    package "orders.states" {
        interface OrderState {
            + pay(o: Order, m: PaymentMethod): void
            + prepare(o: Order): void
            + markReady(o: Order): void
            + deliver(o: Order): void
            + getName(): String
        }
        note right of OrderState
            State:
            cada estado concreto
            implementa solo las
            transiciones validas;
            las invalidas lanzan
            IllegalStateException.
        end note

        class Pending
        class InPreparation
        class Ready
        class Delivered

        OrderState <|.. Pending
        OrderState <|.. InPreparation
        OrderState <|.. Ready
        OrderState <|.. Delivered
    }

    package "orders.observers" {
        interface OrderObserver {
            + onStateChanged(o: Order, s: OrderState): void
        }
        note right of OrderObserver
            Observer:
            multiples elementos pueden
            suscribirse a los cambios
            de estado de un pedido.
        end note

        class TerminalScreenObserver
        class InfoPanelObserver
        class AuditLogObserver

        OrderObserver <|.. TerminalScreenObserver
        OrderObserver <|.. InfoPanelObserver
        OrderObserver <|.. AuditLogObserver
    }

    Order o--> "1" OrderState : state
    Order o--> "0..*" OrderObserver : observers
    Order o--> "0..*" Product : items
}

' =====================================================================
' SUBSISTEMA 4 - PAYMENTS
' Patrones: Strategy, Adapter
' =====================================================================
package "payments" {

    interface PaymentMethod {
        + charge(amount: Double): Boolean
    }
    note right of PaymentMethod
        Strategy:
        el algoritmo de cobro varia
        sin afectar al resto del sistema.
    end note

    class CashPayment
    class BizumPayment {
        - phoneNumber: String
    }

    PaymentMethod <|.. CashPayment
    PaymentMethod <|.. BizumPayment

    package "payments.tpv" {
        class BankTPV {
            + initiateTransaction(): void
            + readCard(): void
            + confirmAmount(amount: Double): void
            + getAuthorizationCode(): String
        }
        note bottom of BankTPV
            Componente externo
            con API incompatible.
        end note

        class BankTPVAdapter {
            - tpv: BankTPV
            + charge(amount: Double): Boolean
        }
        note right of BankTPVAdapter
            Adapter:
            traduce charge(amount) a la
            secuencia que espera el TPV
            real (initiate -> read -> ...).
        end note

        PaymentMethod <|.. BankTPVAdapter
        BankTPVAdapter o--> "1" BankTPV : tpv
    }
}

' =====================================================================
' SUBSISTEMA 5 - KITCHEN Y SYSTEM (raiz)
' Patrones: Singleton, Facade
' =====================================================================
package "kitchen" {
    class Kitchen <<singleton>> {
        - {static} instance: Kitchen
        - queue: Queue<Order>
        - Kitchen()
        + {static} getInstance(): Kitchen
        + enqueue(o: Order): void
        + processNext(): void
        + hasPendingOrders(): Boolean
    }
    note right of Kitchen
        Singleton:
        una unica cocina por local.
        Recibe pedidos y dispara
        product.prepare() (template).
    end note
}

package "system" {

    class Catalog <<singleton>> {
        - {static} instance: Catalog
        - productFactories: Map<String, ProductFactory>
        - toppingFactories: Map<String, ToppingFactory>
        - Catalog()
        + {static} getInstance(): Catalog
        + getProductFactory(category: String): ProductFactory
        + getToppingFactory(beverageName: String): ToppingFactory
    }
    note right of Catalog
        Singleton:
        unico catalogo de productos
        y toppings compartido por
        toda la aplicacion.
    end note

    class CafeteriaManager <<facade>> {
        - {static} instance: CafeteriaManager
        - catalog: Catalog
        - kitchen: Kitchen
        - activeOrders: List<Order>
        - CafeteriaManager()
        + {static} getInstance(): CafeteriaManager
        + createNewOrder(): Order
        + createProduct(category: String, type: String): Product
        + getToppingFactoryFor(beverageName: String): ToppingFactory
        + addProductToOrder(o: Order, p: Product): void
        + checkout(o: Order, m: PaymentMethod): Boolean
        + processKitchenQueue(): void
        + registerObserverOnOrder(o: Order, obs: OrderObserver): void
    }
    note right of CafeteriaManager
        Facade:
        unico punto de entrada para
        la Terminal. Oculta catalog,
        kitchen, payments y orders.
    end note

    class Terminal <<singleton>> {
        - {static} instance: Terminal
        - manager: CafeteriaManager
        - Terminal()
        + {static} getInstance(): Terminal
        + start(): void
    }
    note right of Terminal
        Singleton:
        una unica terminal por local.
        Solo conoce al CafeteriaManager.
    end note

    CafeteriaManager o--> "1" Catalog
    CafeteriaManager o--> "1" Kitchen
    CafeteriaManager o--> "0..*" Order : activeOrders
    Terminal --> CafeteriaManager : usa
    Catalog o--> "0..*" ProductFactory
    Catalog o--> "0..*" ToppingFactory
}

@enduml
